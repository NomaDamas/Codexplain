+    fn run_codexplain_slash_command(&mut self, action: &str) {
+        let action = action.split_whitespace().next().unwrap_or("toggle");
+        let allowed = matches!(
+            action,
+            "toggle" | "on" | "enable" | "off" | "disable" | "status" | "help" | "-h" | "--help"
+        );
+        if !allowed {
+            self.add_error_message("Usage: /codexplain [toggle|on|off|status|help]".to_string());
+            return;
+        }
+        let cwd = self
+            .current_cwd
+            .clone()
+            .unwrap_or_else(|| self.config.cwd.to_path_buf());
+        let local_bin = cwd.join("bin/codexplain");
+        let mut command = if local_bin.exists() {
+            Command::new(local_bin)
+        } else {
+            Command::new("codexplain")
+        };
+        let output = command.current_dir(&cwd).arg("slash").arg(action).output();
+        match output {
+            Ok(output) => {
+                let stdout = String::from_utf8_lossy(&output.stdout).trim().to_string();
+                let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
+                if output.status.success() {
+                    self.add_info_message(
+                        if stdout.is_empty() {
+                            format!("Codexplain {action}: ok")
+                        } else {
+                            stdout
+                        },
+                        None,
+                    );
+                } else {
+                    self.add_error_message(if stderr.is_empty() {
+                        format!("Codexplain {action} failed")
+                    } else {
+                        stderr
+                    });
+                }
+            }
+            Err(error) => {
+                self.add_error_message(format!("Failed to run Codexplain slash command: {error}"));
+            }
+        }
+    }
