+}
+
+fn colorize_codexplain_agent_span(mut span: Span<'static>, full: bool) -> Vec<Span<'static>> {
+    let content = span.content.as_ref();
+    if content.trim().is_empty() {
+        return vec![span];
+    }
+    let current_style = span.style;
+    let has_explicit_fg = current_style.fg.is_some();
+
+    if has_explicit_fg && !full {
+        return vec![span];
+    }
+
+    let highlighted = codexplain_semantic_spans(content, current_style);
+    if highlighted.len() > 1
+        || highlighted
+            .first()
+            .is_some_and(|item| item.style.fg.is_some())
+    {
+        return highlighted;
+    }
+
+    if full && !has_explicit_fg {
+        span.style = current_style.patch(Style::new().fg(Color::Gray));
+    }
+    vec![span]
+}
+
+fn codexplain_semantic_spans(text: &str, base_style: Style) -> Vec<Span<'static>> {
+    let lower = text.to_ascii_lowercase();
+    let mut cursor = 0usize;
+    let mut spans = Vec::new();
+
+    while cursor < text.len() {
+        let Some((start, end, style)) = codexplain_next_semantic_match(text, &lower, cursor) else {
+            spans.push(Span::styled(text[cursor..].to_string(), base_style));
+            break;
+        };
+
+        if start > cursor {
+            spans.push(Span::styled(text[cursor..start].to_string(), base_style));
+        }
+        spans.push(Span::styled(
+            text[start..end].to_string(),
+            base_style.patch(style),
+        ));
+        cursor = end;
+    }
+
+    if spans.is_empty() {
+        spans.push(Span::styled(text.to_string(), base_style));
+    }
+    spans
+}
+
+fn codexplain_next_semantic_match(
+    text: &str,
+    lower: &str,
+    cursor: usize,
+) -> Option<(usize, usize, Style)> {
+    codexplain_semantic_terms()
+        .iter()
+        .filter_map(|(term, color)| {
+            lower[cursor..].find(term).and_then(|offset| {
+                let start = cursor + offset;
+                let end = start + term.len();
+                if text.is_char_boundary(start) && text.is_char_boundary(end) {
+                    Some((start, end, Style::new().fg(*color).bold()))
+                } else {
+                    None
+                }
+            })
+        })
+        .min_by(|left, right| {
+            left.0
+                .cmp(&right.0)
+                .then_with(|| (right.1 - right.0).cmp(&(left.1 - left.0)))
+        })
+}
