+pub(crate) fn codexplain_style_agent_lines(lines: Vec<Line<'static>>) -> Vec<Line<'static>> {
+    if !codexplain_tui_color_enabled() {
+        return lines;
+    }
+    lines
+        .into_iter()
+        .map(|mut line| {
+            if codexplain_line_is_strict_artifact(&line) {
+                return line;
+            }
+            line.spans = line
+                .spans
+                .into_iter()
+                .flat_map(codexplain_style_agent_span)
+                .collect();
+            line
+        })
+        .collect()
+}
+
+fn codexplain_tui_color_enabled() -> bool {
+    let tui_mode = std::env::var("CODEXPLAIN_TUI_COLOR").unwrap_or_default();
+    let color_mode = std::env::var("CODEXPLAIN_COLOR").unwrap_or_default();
+    let disabled = |value: &str| {
+        matches!(
+            value.trim().to_ascii_lowercase().as_str(),
+            "0" | "false" | "off" | "none" | "never" | "no-color" | "plain"
+        )
+    };
+    !disabled(&tui_mode) && !disabled(&color_mode)
+}
+
+fn codexplain_line_is_strict_artifact(line: &Line<'static>) -> bool {
+    let text = line
+        .spans
+        .iter()
+        .map(|span| span.content.as_ref())
+        .collect::<String>();
+    let trimmed = text.trim_start();
+    trimmed.starts_with("```")
+        || trimmed.starts_with('{')
+        || trimmed.starts_with('[')
+        || trimmed.starts_with('+')
+        || trimmed.starts_with('-')
+        || trimmed.starts_with("diff ")
+        || trimmed.starts_with("@@")
+        || trimmed.starts_with("$ ")
+}
+
+fn codexplain_style_agent_span(span: Span<'static>) -> Vec<Span<'static>> {
+    let base_style = span.style;
+    let text = span.content.into_owned();
+    let mut out = Vec::new();
+    let mut chunk = String::new();
+    let mut chunk_is_word: Option<bool> = None;
+
+    for ch in text.chars() {
+        let is_word = ch.is_alphanumeric()
+            || matches!(
+                ch,
+                '_' | '-' | '/' | '.' | ':' | '@' | '#' | '+' | '=' | '<' | '>'
+            )
+            || ('가'..='힣').contains(&ch);
+        if chunk_is_word.is_some_and(|previous| previous != is_word) {
+            codexplain_push_styled_chunk(&mut out, &chunk, base_style);
+            chunk.clear();
+        }
+        chunk_is_word = Some(is_word);
+        chunk.push(ch);
+    }
+
+    if !chunk.is_empty() {
+        codexplain_push_styled_chunk(&mut out, &chunk, base_style);
+    }
+    out
+}
+
+fn codexplain_push_styled_chunk(out: &mut Vec<Span<'static>>, chunk: &str, base_style: Style) {
+    let style = codexplain_semantic_style(chunk)
+        .map(|semantic| base_style.patch(semantic))
+        .unwrap_or(base_style);
+    out.push(Span::styled(chunk.to_string(), style));
+}
+
+fn codexplain_semantic_style(token: &str) -> Option<Style> {
+    let normalized = token
+        .trim_matches(|ch: char| !ch.is_alphanumeric() && ch != '/' && ch != '-' && ch != '_')
+        .to_ascii_lowercase();
+    if normalized.is_empty() {
+        return None;
+    }
+    let style = if matches!(
+        normalized.as_str(),
+        "pass"
+            | "ok"
+            | "success"
+            | "done"
+            | "complete"
+            | "completed"
+            | "장점"
+            | "완료"
+            | "성공"
+            | "통과"
+            | "보존"
+    ) {
+        Style::default()
+            .fg(Color::Green)
+            .add_modifier(Modifier::BOLD)
+    } else if matches!(
+        normalized.as_str(),
+        "warn"
+            | "warning"
+            | "risk"
+            | "risky"
+            | "주의"
+            | "위험"
+            | "리스크"
+            | "단점"
+            | "한계"
+            | "비용"
+    ) {
+        Style::default()
+            .fg(Color::Yellow)
+            .add_modifier(Modifier::BOLD)
+    } else if matches!(
+        normalized.as_str(),
+        "fail" | "failed" | "error" | "blocked" | "panic" | "실패" | "오류" | "차단"
+    ) {
+        Style::default().fg(Color::Red).add_modifier(Modifier::BOLD)
+    } else if normalized.starts_with("./")
+        || normalized.starts_with("/")
+        || normalized.ends_with(".rs")
+        || normalized.ends_with(".md")
+        || normalized.ends_with(".json")
+        || normalized.ends_with(".toml")
+        || normalized.contains("::")
+    {
+        Style::default().fg(Color::Cyan)
+    } else if matches!(
+        normalized.as_str(),
+        "codexplain"
+            | "codex"
+            | "tui"
+            | "renderer"
+            | "policy"
+            | "profile"
+            | "selector"
+            | "adapter"
+            | "shim"
+            | "rust"
+            | "cli"
+            | "architecture"
+            | "아키텍처"
+            | "렌더러"
+            | "정책"
+            | "프로필"
+    ) {
+        Style::default()
+            .fg(Color::Blue)
+            .add_modifier(Modifier::BOLD)
+    } else if matches!(
+        normalized.as_str(),
+        "next" | "action" | "todo" | "다음" | "행동" | "명령" | "실행"
+    ) {
+        Style::default()
+            .fg(Color::Magenta)
+            .add_modifier(Modifier::BOLD)
+    } else {
+        return None;
+    };
+    Some(style)
+}
