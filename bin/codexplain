#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BIN="$ROOT/target/release/codexplain"
SRC="$ROOT/rust/codexplain.rs"
MANIFEST="$ROOT/Cargo.toml"
if [ -x "$BIN" ] && [ ! "$SRC" -nt "$BIN" ] && [ ! "$MANIFEST" -nt "$BIN" ]; then
  exec "$BIN" "$@"
fi
exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- "$@"
